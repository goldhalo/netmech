<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   NetMechanism.vcxproj —— 静态库工程（Visual Studio 2019 / v142 / C++17）
  ============================================================================
   构建产物 : NetMechanism.lib（静态库）
   输出目录 : $(SolutionDir)bin\$(Configuration)\
   中间目录 : $(SolutionDir)obj\$(ProjectName)\$(Platform)\$(Configuration)\

   与 CMake 构建的关系
   ========================================================
   本工程与 CMakeLists.txt **完全等价**，两者可以并存：
     * CMake 是跨平台主力构建（同时产出测试与示例）；
     * 本工程供 Windows 开发者直接在 VS2019 里编译/调试库本身。

   ⚠ 工程约束
   ========================================================
   1. **必须使用 DLL 版运行时（/MD 或 /MDd）**
      与其它组件保持一致的 CRT 才能互相传递 STL 对象。

   2. **必须加 /source-charset:utf-8（或源文件带 BOM）**
      本库源码含中文注释；在 GBK(936) 代码页下不加会触发
      成片 C4819 警告并连锁出编译错误。

   3. **_WIN32_WINNT 必须显式定义**
      Asio 需要它；未定义会给出 "Please define _WIN32_WINNT" 提示。

   依赖：独立 Asio（header-only），位于 thirdparty/asio/include，
       **无需安装或链接第三方库**。
  ============================================================================
-->
<Project DefaultTargets="Build" ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{A7F3C1E2-4B8D-4F6A-9C2E-1D5B8A3F7E90}</ProjectGuid>
    <RootNamespace>NetMechanism</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- ======================================================================
       配置属性
       ====================================================================== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- 输出根目录：与 CMake 的布局保持一致（src/wtoe/NetMechanism/build/bin） -->
    <NetmechOutRoot Condition="'$(NetmechOutRoot)'==''">$(MSBuildThisFileDirectory)build\bin</NetmechOutRoot>
    <NetmechIntRoot Condition="'$(NetmechIntRoot)'==''">$(MSBuildThisFileDirectory)build\obj</NetmechIntRoot>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(NetmechOutRoot)\$(Configuration)\</OutDir>
    <IntDir>$(NetmechIntRoot)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>NetMechanism</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>
  <!-- ======================================================================
       编译 / 链接选项
       ====================================================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- ★ 语言标准：仅 C++17，禁用 C++20 -->
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- ★ /utf-8：源码含中文注释，必须显式声明编码
           ★ /bigobj：Asio 模板实例化较多，默认 obj 段数可能不够
           注意：这两项必须写在**同一个** AdditionalOptions 元素里。
           MSBuild 中同一 ItemDefinitionGroup 内重复出现该元素时，
           后者会覆盖前者（曾因此导致 /utf-8 丢失，触发成片 C4819）。 -->
      <AdditionalOptions>%(AdditionalOptions) /source-charset:utf-8 /bigobj /Zc:__cplusplus /wd4459 /external:W0 /external:I"$(MSBuildThisFileDirectory)thirdparty\asio\include"</AdditionalOptions>
      <!-- ★ /W4：与 CMake 构建保持同一警告级别（本库目标为零警告） -->
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32_LEAN_AND_MEAN;
        NOMINMAX;
        _WIN32_WINNT=0x0601;
        _WIN32;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <!-- Debug：/MDd（动态 CRT，调试版） -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Release：/MD（动态 CRT） -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- ======================================================================
       源文件
       ====================================================================== -->
      <ItemGroup Label="Sources">
    <ClCompile Include="src\acceptor.cpp" />
    <ClCompile Include="src\address.cpp" />
    <ClCompile Include="src\conn.cpp" />
    <ClCompile Include="src\error.cpp" />
    <ClCompile Include="src\io_pool.cpp" />
    <ClCompile Include="src\mechanism.cpp" />
    <ClCompile Include="src\runtime.cpp" />
    <ClCompile Include="src\serial.cpp" />
    <ClCompile Include="src\timer.cpp" />
    <ClCompile Include="src\udp_endpoint.cpp" />
    <ClCompile Include="src\worker_pool.cpp" />
  </ItemGroup>
      <ItemGroup Label="PrivateHeaders">
    <ClInclude Include="src\acceptor.hpp" />
    <ClInclude Include="src\address_internal.hpp" />
    <ClInclude Include="src\conn_state.hpp" />
    <ClInclude Include="src\io_pool.hpp" />
    <ClInclude Include="src\netmech_srcpch.hpp" />
    <ClInclude Include="src\protocol_traits.hpp" />
    <ClInclude Include="src\registry.hpp" />
    <ClInclude Include="src\timer.hpp" />
  </ItemGroup>
      <ItemGroup Label="PublicHeaders">
    <ClInclude Include="include\netmech\common.hpp" />
    <ClInclude Include="include\netmech\conn.hpp" />
    <ClInclude Include="include\netmech\iohandler.hpp" />
    <ClInclude Include="include\netmech\linkable.hpp" />
    <ClInclude Include="include\netmech\mechanism.hpp" />
    <ClInclude Include="include\netmech\net.hpp" />
    <ClInclude Include="include\netmech\serial.hpp" />
    <ClInclude Include="include\netmech\udp.hpp" />
    <ClInclude Include="include\netmech\worker_pool.hpp" />
  </ItemGroup>
  <ItemGroup Label="Docs">
    <None Include="README.md" />
    <None Include="CMakeLists.txt" />
    <None Include="build_and_test.ps1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>